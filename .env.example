# Flask Configuration
SECRET_KEY=change-this-to-a-super-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
FLASK_ENV=development
PORT=5000

# Database Configuration
# Defaults to SQLite for local development. Set to PostgreSQL URI for production.
# Example PostgreSQL: postgresql://username:password@localhost:5432/fitness_db
DATABASE_URL=sqlite:///fitness.db

# AI Integrations
# Gemini API Key (for Exercise & Diet Coaching, Timeline, and Daily Tasks)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (for biometrics insights)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
